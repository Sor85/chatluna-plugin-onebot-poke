{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "noPropertyAccessFromIndexSignature": false,
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false
  },
  "include": ["client", "src"]
}
